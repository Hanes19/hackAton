# Supabase (required for shops/auth)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini — free tier at https://aistudio.google.com/apikey
# Without this key the assistant still works with rule-based fallback responses.
GEMINI_API_KEY=your_gemini_api_key

# Frontend (SvelteKit — use PUBLIC_ prefix)
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
